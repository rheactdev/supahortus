# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PRIVATE_SUPABASE_SECRET_KEY=your-secret-key

# Comma-separated Supabase user UUIDs allowed to access /admin.
ADMIN_USER_IDS=

# S3-compatible storage
S3_ACCESS_KEY=your-access-key
S3_SECRET=your-secret-key
S3_ENDPOINT=s3.example.com
S3_REGION=your-region
S3_BUCKET_NAME=your-bucket-name

# Optional B2 SSE-C. Leave the active version empty until rollout.
S3_SSE_C_ACTIVE_VERSION=
# S3_SSE_C_KEY_V1=<base64-encoded 32-byte secret>

# Used by set-cors.js. Separate multiple origins with commas.
S3_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Upstash QStash and Workflows
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# Optional Photoshop and Affinity thumbnail processor
IMAGE_PROCESSOR_URL=
PROCESSOR_SECRET=

# Optional public app URL override for workflow callbacks.
UPSTASH_WORKFLOW_URL=http://localhost:3000

# Optional when Vercel Deployment Protection is enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Vercel provides these automatically in deployed environments.
# VERCEL_URL=
# VERCEL_PROJECT_PRODUCTION_URL=

# Local server port; defaults to 3000.
# PORT=3000
